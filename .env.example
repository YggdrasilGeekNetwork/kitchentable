# Copy to .env and fill in before `docker compose up`.

# Generate with: bin/rails secret
SECRET_KEY_BASE=

# Only needed if you're NOT using --profile with-datastores (bringing your own Postgres/Redis)
# DATABASE_URL=postgres://user:pass@host:5432/kitchentable_production
# REDIS_URL=redis://host:6379/0

# Feature flags — module toggles, see README
ENABLE_AV=false
ENABLE_OVERLAY=false
