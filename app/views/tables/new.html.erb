<section class="kt-panel">
  <h1>Criar mesa</h1>
  <p class="kt-muted">Uma mesa virtual de Magic para jogar com os amigos: cada um cola o próprio deck, e vocês jogam pelo navegador, sem conta e sem instalar nada. As regras ficam com os jogadores, como numa mesa de verdade.</p>

  <%= form_with url: tables_path, method: :post, class: "kt-form" do %>
    <label class="kt-field">
      Seu nome
      <input type="text" name="display_name" required maxlength="40" autocomplete="nickname" autofocus class="kt-input">
    </label>

    <div class="kt-row">
      <label class="kt-field">
        Formato
        <select name="mtg_format" class="kt-input">
          <option value="commander">Commander</option>
          <option value="standard">Standard</option>
        </select>
      </label>

      <label class="kt-field">
        Jogadores
        <input type="number" name="max_seats" value="4" min="1" max="8" required class="kt-input">
      </label>
    </div>

    <label class="kt-field">
      <span>Nome da mesa <span class="kt-optional">· opcional</span></span>
      <input type="text" name="name" maxlength="60" placeholder="Commander de sexta" class="kt-input">
    </label>

    <button type="submit" class="kt-btn kt-btn-primary" data-turbo-submits-with="Criando…">Criar mesa</button>
  <% end %>

  <p class="kt-hint">Depois de criar, copie o link de convite no tabuleiro e mande para os outros jogadores.</p>
</section>
