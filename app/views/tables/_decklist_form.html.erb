<%= form_with url: table_seat_decklist_path(table, seat_id), method: :post,
              id: "kt-decklist-form", class: "kt-form", data: { controller: "decklist-form" } do %>
  <input type="hidden" name="mtg_format" value="<%= table.format %>">
  <% if @decklist_errors.present? %>
    <div class="kt-form-error" role="alert">
      <strong>Não foi possível usar este deck:</strong>
      <ul>
        <% @decklist_errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <label class="kt-field">
    Lista (texto)
    <textarea name="raw_text" rows="12" required placeholder="1 Sol Ring&#10;1 Arcane Signet&#10;35 Island"
              data-decklist-form-target="list" data-action="input->decklist-form#refresh"><%= @raw_text %></textarea>
    <small class="kt-field-hint" data-decklist-form-target="summary" aria-live="polite"></small>
  </label>
  <% if table.format == "commander" %>
    <label class="kt-field">
      Comandante
      <input type="text" name="commander" value="<%= @commander %>" list="commander-options" required
             placeholder="Atraxa, Praetors' Voice" autocomplete="off">
    </label>
    <label class="kt-field">
      Segundo comandante (Partner/Background) — opcional
      <input type="text" name="partner" value="<%= @partner %>" list="commander-options" autocomplete="off">
    </label>
    <datalist id="commander-options" data-decklist-form-target="commanderOptions"></datalist>
  <% end %>
  <button type="submit" class="kt-btn kt-btn-primary" data-board-target="decklistSubmit"
          data-turbo-submits-with="Enviando…">Enviar deck</button>
<% end %>
