# Kamal secrets, read from the deploy workflow's environment (GitHub secrets) — no
# values are stored here. See docs/deploy.md.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# The app reaches the `db` accessory by its container name on Kamal's network.
# POSTGRES_PASSWORD must be URL-safe (e.g. `openssl rand -hex 32`).
DATABASE_URL=postgres://kitchentable:$POSTGRES_PASSWORD@kitchentable-db:5432/kitchentable_production
